<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>

    <AssemblyName>Yukari.Plugin.MangaDex</AssemblyName>
    <RootNamespace>Yukari.Plugin.MangaDex</RootNamespace>

    <Version>2.2.1+core2.2.0</Version>
    <AssemblyVersion>2.2.1</AssemblyVersion>
    <AssemblyFileVersion>$(AssemblyVersion)</AssemblyFileVersion>
    <AssemblyInformationalVersion>$(Version)</AssemblyInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <AssemblyTitle>Yukari MangaDex Plugin</AssemblyTitle>
    <AssemblyProduct>Yukari</AssemblyProduct>
    <Description>MangaDex comic source plugin for Yukari.</Description>
    <Copyright>Copyright © TXG0Fk3. All rights reserved.</Copyright>
    <AssemblyCopyright>Copyright © TXG0Fk3. All rights reserved.</AssemblyCopyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yukari.Core" Version="2.2.0" />
  </ItemGroup>
</Project>
